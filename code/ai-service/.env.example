# PromptShield AI Service — Environment Configuration Example
# Copy to ai-service/.env, fill in values, never commit .env

# ── Service-to-service authentication ────────────────────────────────────────
# Must match AI_SERVICE_API_KEY set on the Spring Boot backend.
# Generate: openssl rand -hex 32
# Leave empty to disable authentication for local development only.
AI_SERVICE_API_KEY=!!CHANGE!!

# ── General Service Settings ──────────────────────────────────────────────────
MAX_PROMPT_LENGTH=8000
SPACY_MODEL=en_core_web_sm
TOKENIZER_MODEL=gpt-4o-mini

# ── LLMLingua-2 Model Settings ────────────────────────────────────────────────
# Primary compression model running on your Fedora laptop with NVIDIA RTX 3050.
LLMLINGUA_ENABLED=true
LLMLINGUA_MODEL_ID=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank
LLMLINGUA_DEVICE=auto                # auto (CUDA if available), cpu, or cuda
LLMLINGUA_RATE=0.75                  # Token retention rate
LLMLINGUA_TARGET_TOKEN=-1
LLMLINGUA_TIMEOUT_SECONDS=30.0
LLMLINGUA_MAX_CONCURRENT_REQUESTS=1  # Protect GPU — only 1 inference at a time
LLMLINGUA_FORCE_RESERVE_DIGIT=true
LLMLINGUA_DROP_CONSECUTIVE=true
LLMLINGUA_MIN_SEMANTIC_SCORE=70.0
LLMLINGUA_MAX_FORCE_TOKENS=100
# Set to false once model weights are cached (avoids network calls on startup)
LLMLINGUA_USE_ONLINE_DOWNLOAD=true

# ── FLAN-T5 Model Settings (Optional Candidate Generator) ─────────────────────
FLAN_T5_ENABLED=false
FLAN_T5_MODEL_ID=google/flan-t5-small
FLAN_T5_DEVICE=auto
FLAN_T5_MAX_INPUT_TOKENS=512
FLAN_T5_MAX_NEW_TOKENS=192
FLAN_T5_NUM_BEAMS=2
FLAN_T5_TIMEOUT_SECONDS=20.0
FLAN_T5_MAX_CONCURRENT_REQUESTS=1
FLAN_T5_USE_ONLINE_DOWNLOAD=false
FLAN_T5_MIN_SEMANTIC_SCORE=70.0

# ── HuggingFace cache ─────────────────────────────────────────────────────────
# Persistent model cache — set to a directory with enough disk space (5+ GB)
# HF_HOME=~/.cache/huggingface
# TRANSFORMERS_CACHE=~/.cache/huggingface/hub
