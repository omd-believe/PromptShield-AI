# PromptShield Frontend — Environment Variables
#
# VITE variables are injected at BUILD TIME by Vite.
# They are NOT secrets — they appear in the compiled JavaScript bundle.
# Never put backend secrets, JWT keys, or AI service credentials here.
#
# 1. Copy this file: cp .env.example .env
# 2. Set the backend URL for your deployment.
# 3. Run: npm run build
#
# For local development (default fallback is already set in api.js):
# VITE_API_BASE_URL=http://localhost:8080/api/v1
#
# For Render/Vercel production deployment, set in your deployment dashboard:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1

VITE_API_BASE_URL=http://localhost:8080/api/v1

