# PromptShield-AI — environment template
# 1. Copy this file: cp .env.example .env
# 2. Fill in all REQUIRED fields (marked !!CHANGE!!)
# 3. Never commit .env to Git — it is listed in .gitignore

# ──────────────────────────────────────────────────────────────────
# Required secrets
# ──────────────────────────────────────────────────────────────────

# PostgreSQL password (used by both postgres and backend services)
POSTGRES_PASSWORD=!!CHANGE!!   # e.g. openssl rand -base64 24

# JWT signing secret — must be at least 32 characters, randomly generated
JWT_SECRET=!!CHANGE!!          # e.g. openssl rand -base64 48

# AI service shared API key — backend sends this header to authenticate with FastAPI
# Generate: openssl rand -hex 32
AI_SERVICE_API_KEY=!!CHANGE!!

# ──────────────────────────────────────────────────────────────────
# Optional overrides (defaults shown)
# ──────────────────────────────────────────────────────────────────

JWT_EXPIRATION=86400000     # 24 h in milliseconds

# Frontend URL(s) for CORS — comma-separated
# In Docker dev: http://localhost:5173
# In production: https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Vite build-time API base URL — set when building the frontend Docker image
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Compression engine: auto | llmlingua | flan-t5 | deterministic
COMPRESSION_ENGINE=auto

# LLMLingua-2
LLMLINGUA_ENABLED=true
LLMLINGUA_MODEL_ID=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank
LLMLINGUA_USE_ONLINE_DOWNLOAD=true   # set false if weights are pre-cached
LLMLINGUA_DEVICE=auto                # auto | cpu | cuda
LLMLINGUA_RATE=0.75                  # 0.85=light  0.75=balanced  0.65=aggressive
LLMLINGUA_TARGET_TOKEN=-1            # -1 = use LLMLINGUA_RATE; positive int = hard budget
LLMLINGUA_TIMEOUT_SECONDS=30.0
LLMLINGUA_MAX_CONCURRENT_REQUESTS=1
LLMLINGUA_FORCE_RESERVE_DIGIT=true
LLMLINGUA_DROP_CONSECUTIVE=true
LLMLINGUA_MIN_SEMANTIC_SCORE=70.0
LLMLINGUA_MAX_FORCE_TOKENS=100

# FLAN-T5 (disabled by default)
FLAN_T5_ENABLED=false
FLAN_T5_MODEL_ID=google/flan-t5-small
FLAN_T5_USE_ONLINE_DOWNLOAD=true
FLAN_T5_DEVICE=auto
FLAN_T5_TIMEOUT_SECONDS=30.0
